# Run artifacts are machine-generated and accumulate fast - a 30-epoch run
# writes a metrics stream, a predictions file per epoch and a full text log.
# Only the empty directories are tracked, so a fresh clone has the layout the
# pipeline writes into. Use `python scripts/maintenance/summarize_runs.py` to
# compare runs locally; nothing here needs to survive in git history.
#
# Artifacts are grouped by model domain - asr/ today, translation/ in phase two
# - so the rules below are written against */ rather than a fixed domain name
# and cover any future one without being edited again.

# Shared across domains: one flat stream of run logs keyed by run id.
logs/*
!logs/.gitkeep

*/runs/*
!*/runs/.gitkeep

# Weights and exports: large binaries, regenerated by train.sh / export_model.sh.
# Note last_model.pt also carries optimizer state for --resume, so it is roughly
# three times the size of the plain weights in best_model.pt.
*/checkpoints/
*/exports/
*/weights/

# Downloaded third-party weights (the SpeechBrain ECAPA encoder used by the
# diarization backend caches itself here). Shared, not domain-scoped.
models/

# The character n-gram language model. A few megabytes of JSON, and fully
# reproducible from the checked-in Twi text with
# `python scripts/lm/build_lm.py`, so it is rebuilt rather than committed.
*/lm/

# The model registry is the exception, and deliberately so: its weights are
# excluded by the *.pt rule below, but registry.json and each version's
# metadata.json ARE tracked. They are small, and they record which model was
# served when, with what WER - the provenance of every published export.
# A fresh clone therefore has the history without the binaries; the registry
# skips version directories whose weights are absent rather than pointing at
# files that are not there.
!*/registry/
!*/registry/**/metadata.json
!*/registry/registry.json
*.pt
*.pth
*.pte
*.ckpt
*.bin
*.safetensors
*.onnx
*.tflite
