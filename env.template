# Sample environment variables for local development.
# Copy this file to .env and fill in the values. Never commit .env.

# HuggingFace access token (https://huggingface.co/settings/tokens).
# Required for gated datasets such as Lagyamfi/akan_audio_processed - accept its
# terms once at https://huggingface.co/datasets/Lagyamfi/akan_audio_processed
# while logged in, then paste a read token here.
HF_TOKEN=

# Optional: HuggingFace repository for the Whisper comparison baseline.
# Leave EMPTY to use the models trained in this repo, which is the default -
# they are served from outputs/registry/ (see `python -m src.main models list`).
# Setting this adds a "whisper" option to the app for side-by-side comparison.
MODEL_REPO_ID=
